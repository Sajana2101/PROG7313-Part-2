<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F3FA">

    <!-- top toolbar section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#43A047"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <!-- menu icon -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hamburger_menu"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

        <!-- profile icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Profile_icon"
            android:textColor="#283593"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- scrollable dashboard content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- welcome message -->
            <TextView
                android:id="@+id/tvWelcomeUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_back_"
                android:textAlignment="center"
                android:textColor="#263238"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- date filter button -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_date"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="@drawable/loginbtn_outline"
                android:layout_marginBottom="12dp" />

            <!-- expense summary card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:background="@drawable/login_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/expense_summary"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalExpenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_r0_00"
                    android:textColor="#263238"
                    android:textSize="16sp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvTotalLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monthly_limit_r0_00"
                    android:textColor="#546E7A"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp" />

                <!-- pie chart showing spending breakdown -->
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartHome"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <!-- Visual indicator card for budget performance -->
            <LinearLayout
                android:id="@+id/budgetPerformanceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/login_card_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/budget_performance"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvBudgetPeriod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/last_30_days"
                    android:textColor="#546E7A"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvBudgetStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_no_monthly_goals_set"
                    android:textColor="#263238"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvBudgetRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/minimum_r0_00_maximum_r0_00"
                    android:textColor="#546E7A"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvBudgetPercentage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/_0_of_maximum_goal_used"
                    android:textColor="#546E7A"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <ProgressBar
                    android:id="@+id/pbMonthlyProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvBudgetAdvice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/set_your_monthly_goals_to_view_your_progress"
                    android:textColor="#263238"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnGenerateBudgetReport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/generate_report"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:padding="10dp"
                    android:background="@drawable/loginbtn_outline"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- category totals section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/category_totals"
                android:textColor="#263238"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- dynamically loads category cards -->
            <LinearLayout
                android:id="@+id/categoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- bottom navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#2196F3">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/Home1"
            android:textColor="#212121"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/categories_home"
            android:textColor="#212121"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/navAddExpense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/AddGoals"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navGoals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/goals_home"
            android:textColor="#212121"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/profile_nav"
            android:textColor="#212121"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/navSavingsDebt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Savings"
            android:textColor="#212121"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>