<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF3E0">

    <!-- top header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:background="#43A047">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monthly_goals_page"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- main content section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- page heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/users_set_monthly_budget_goals"
                android:textColor="#263238"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- short instructions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enter_the_minimum_and_maximum_amount_you_want_to_spend_for_the_month"
                android:textColor="#546E7A"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="22dp" />

            <!-- tried to mimic a card-style for this section,
                 used to group the monthly goal inputs clearly -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#F2EFC0">

                <!-- budget goal form title -->
                <TextView
                    android:id="@+id/edtGoals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/budget_goal_details"
                    android:textColor="#263238"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- minimum goal input -->
                <EditText
                    android:id="@+id/edtMinGoal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="#FFF3E0"
                    android:hint="@string/enter_minimum_monthly_goal"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:textColorHint="#D32F2F" />

                <!-- maximum goal input -->
                <EditText
                    android:id="@+id/edtMaxGoal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="#FFF3E0"
                    android:hint="@string/enter_a_maximum_monthly_goal"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:textColorHint="#D32F2F" />

                <!-- saves goal changes -->
                <Button
                    android:id="@+id/btnSaveGoalChanges"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/save_changes"
                    android:textAllCaps="false" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- bottom navigation -->
    <include layout="@layout/view_bottom_navigation" />

</LinearLayout>