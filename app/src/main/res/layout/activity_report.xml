<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8E7">

    <!-- top toolbar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center"
        android:background="#43A047"
        android:text="@string/budget_report"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvReportTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/budget_performance_report"
                android:textColor="#263238"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvReportPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/last_30_days_report"
                android:textColor="#546E7A"
                android:textSize="14sp"
                android:layout_marginBottom="18dp" />

            <!-- summary card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/login_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvReportMinimum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/minimum_goal_r0_00"
                    android:textColor="#263238"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvReportSpent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/actual_spending_r0_00"
                    android:textColor="#263238"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvReportMaximum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/maximum_goal_r0_00"
                    android:textColor="#263238"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvReportStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_no_monthly_goals_set_report"
                    android:textColor="#263238"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvReportAdvice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/set_your_goals_to_view_your_budget_performance"
                    android:textColor="#546E7A"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/visual_report"
                android:textColor="#263238"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/budgetReportBarChart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/tvReportExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/this_report_compares_your_actual_spending_for_the_last_30_days_against_your_minimum_and_maximum_monthly_goals"
                android:textColor="#546E7A"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/btnBackHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back_to_home"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#263238"
                android:padding="10dp"
                android:background="@drawable/loginbtn_outline" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>